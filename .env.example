# Supabase project settings — Project Settings > API in the Supabase dashboard.
# (Newer Supabase projects issue "publishable"/"secret" keys instead of the
# older "anon"/"service_role" JWTs — same roles, new names. Either key format
# works here; use whatever your project's API settings page shows you.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secret/service-role key — server-only, used by the seed script. NEVER
# expose this to the browser or prefix it with NEXT_PUBLIC_. It bypasses Row
# Level Security.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Optional stretch goals (leave blank until wired up):
# Google OAuth (Supabase Auth > Providers > Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Food database API integration point (see food_logs.external_food_id)
# USDA_FDC_API_KEY=
